%% scalefnt.sty - Minimal standalone scalable fonts package
%% Provides basic font scaling without external dependencies
%% Used for offline LaTeX compilation

\ProvidesPackage{scalefnt}[2024/12/01 Standalone Scalable Fonts]

% Provide basic \scalefont command if not already defined
\providecommand{\scalefont}[1]{%
  \fontsize{#1}{#1}\selectfont
}

% Empty package - relies on existing TeX font system
\endinput
